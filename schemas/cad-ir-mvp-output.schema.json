            "$ref": "#/$defs/path_segment"
          },
          "minItems": 2,
          "maxItems": 200
        }
      },
      "required": [
        "segments",
        "type"
      ],
      "additionalProperties": false
    },
    "circle_contour": {
      "type": "object",
      "properties": {
