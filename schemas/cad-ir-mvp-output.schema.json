{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad.example.com/schemas/cad-ir-mvp-output/1.11",
  "title": "CAD-IR 1.11, narrowed to the geometry this build can construct",
  "description": "A subset of the canonical CAD-IR schema, expressed in the dialect the Codex structured-output API accepts: anyOf rather than oneOf, every node typed, every array with items, and every object listing all of its properties as required. The canonical schema says what version 1.2 can express; this says what may be generated, so the model is constrained at generation time instead of being corrected by a repair loop. Auxiliary planes and face selectors are part of 1.2 but not offered here: a selector's predicates are individually optional, and a dialect without optional properties would force the model to emit predicates the trusted validator rejects. Semantics the dialect cannot state — that a contour closes, for instance — are enforced by the adapter before anything reaches KOMPAS.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "cad-ai/cad-ir"
    },
    "schema_version": {
      "type": "string",
      "const": "1.11"
    },
    "document": {
      "type": "object",
      "properties": {
        "units": {
          "type": "string",
          "const": "mm"
        },
        "part_type": {
          "type": "string",
          "const": "single_part"
        },
        "coordinate_system": {
          "type": "string",
          "const": "right_handed"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "coordinate_system",
        "name",
        "part_type",
        "units"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "type": {
            "type": "string",
            "const": "length"
          },
          "value": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "unit": {
            "type": "string",
            "const": "mm"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "user_confirmed",
              "inferred",
              "assumed"
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "provenance",
          "status",
          "type",
          "unit",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "features": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/base_extrusion"
          },
          {
            "$ref": "#/$defs/cut_extrusion"
          },
          {
            "$ref": "#/$defs/blind_cut_extrusion"
          },
          {
            "$ref": "#/$defs/datum_plane"
          },
          {
            "$ref": "#/$defs/boss_extrusion"
          },
          {
            "$ref": "#/$defs/linear_pattern"
          },
          {
            "$ref": "#/$defs/circular_pattern"
          },
          {
            "$ref": "#/$defs/corner_fillet"
          },
          {
            "$ref": "#/$defs/corner_chamfer"
          },
          {
            "$ref": "#/$defs/bore_chamfer"
          },
          {
            "$ref": "#/$defs/hollow"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "expectations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/bounding_box_expectation"
          },
          {
            "$ref": "#/$defs/count_expectation"
          }
        ]
      },
      "minItems": 2,
      "maxItems": 8
    },
    "reference_geometry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 0
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generator": {
          "type": "string",
          "maxLength": 100
        },
        "generator_version": {
          "type": "string",
          "maxLength": 50
        },
        "prompt_version": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "generator",
        "generator_version",
        "prompt_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "document",
    "expectations",
    "features",
    "metadata",
    "parameters",
    "reference_geometry",
    "schema",
    "schema_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
    },
    "scalar_quotient": {
      "type": "object",
      "properties": {
        "divide": {
          "$ref": "#/$defs/scalar"
        },
        "by": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "required": [
        "by",
        "divide"
      ],
      "additionalProperties": false
    },
    "scalar_negation": {
      "type": "object",
      "properties": {
        "negate": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "negate"
      ],
      "additionalProperties": false
    },
    "scalar": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "object",
          "properties": {
            "parameter": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "parameter"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/scalar_quotient"
        },
        {
          "$ref": "#/$defs/scalar_negation"
        }
      ]
    },
    "point": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scalar"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "line_segment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "line"
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        }
      },
      "required": [
        "end",
        "start",
        "type"
      ],
      "additionalProperties": false
    },
    "arc_segment": {
      "type": "object",
      "properties": {
        "type": {
