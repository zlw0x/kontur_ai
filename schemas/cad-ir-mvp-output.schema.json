        }
      },
      "required": [
        "center",
        "id",
        "radius",
        "type"
      ],
      "additionalProperties": false
    },
    "construction_entity": {
      "anyOf": [
        {
          "$ref": "#/$defs/construction_point"
        },
        {
          "$ref": "#/$defs/construction_line"
        },
        {
          "$ref": "#/$defs/construction_circle"
        }
      ]
    },
    "sketch": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "plane": {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "base"
            },
            "plane": {
              "type": "string",
              "const": "XY"
            }
          },
          "required": [
            "on",
            "plane"
          ],
          "additionalProperties": false
        },
        "outer": {
          "$ref": "#/$defs/contour"
        },
        "inner": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contour"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "construction": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/construction_entity"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 0
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 0
        }
      },
      "required": [
        "constraints",
        "construction",
        "dimensions",
        "id",
        "inner",
        "outer",
        "plane"
      ],
