        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "width": {
          "$ref": "#/$defs/scalar"
        },
        "height": {
          "$ref": "#/$defs/scalar"
        },
        "rotation_deg": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "center",
        "height",
        "rotation_deg",
        "type",
        "width"
      ],
      "additionalProperties": false
