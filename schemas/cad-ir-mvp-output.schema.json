        "sides": {
          "type": "integer",
          "minimum": 3,
          "maximum": 64
        },
        "circumradius": {
          "$ref": "#/$defs/scalar"
        },
        "rotation_deg": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
