{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad.example.com/schemas/cad-ir-mvp-output/1.1",
  "title": "CAD-IR 1.1, narrowed to the geometry this build can construct",
  "description": "A subset of the canonical CAD-IR schema. The canonical schema says what version 1.1 can express; this says what the KOMPAS adapter can actually build, so the model is constrained at generation time instead of being corrected by a repair loop.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "document",
    "parameters",
    "features",
    "expectations",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cad-ai/cad-ir"
    },
    "schema_version": {
      "const": "1.1"
    },
    "document": {
      "type": "object",
      "required": [
        "units"
      ],
      "additionalProperties": false,
      "properties": {
        "units": {
          "const": "mm"
        },
        "part_type": {
          "const": "single_part"
        },
        "coordinate_system": {
          "const": "right_handed"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "value",
          "unit",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "type": {
            "const": "length"
          },
          "value": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "unit": {
            "const": "mm"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "enum": [
              "confirmed",
              "user_confirmed",
              "inferred",
              "assumed"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "note": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/base_extrusion"
          },
          {
            "$ref": "#/$defs/circular_cut"
          }
        ]
      }
    },
    "expectations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "size_mm",
              "tolerance_mm"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "type": {
                "const": "bounding_box"
              },
              "size_mm": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "y": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "z": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "tolerance_mm": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "type": {
                "enum": [
                  "body_count",
                  "through_hole_count"
                ]
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "generator",
        "generator_version"
      ],
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "string",
          "maxLength": 100
        },
        "generator_version": {
          "type": "string",
          "maxLength": 50
        },
        "prompt_version": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "reference_geometry": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
    },
    "scalar": {
      "oneOf": [
        {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "object",
          "required": [
            "parameter"
          ],
          "additionalProperties": false,
          "properties": {
            "parameter": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "base_extrusion": {
      "type": "object",
      "required": [
        "id",
        "type",
        "enabled",
        "depends_on",
        "produces",
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "solid.extrude"
        },
        "enabled": {
          "const": true
        },
        "depends_on": {
          "type": "array",
          "maxItems": 0
        },
        "produces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "kind": {
                "enum": [
                  "solid_body",
                  "face"
                ]
              }
            }
          },
          "contains": {
            "properties": {
              "kind": {
                "const": "solid_body"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "inputs": {
          "type": "object",
          "required": [
            "sketch",
            "direction",
            "distance"
          ],
          "additionalProperties": false,
          "properties": {
            "direction": {
              "const": "+Z"
            },
            "distance": {
              "$ref": "#/$defs/scalar"
            },
            "sketch": {
              "type": "object",
              "required": [
                "id",
                "plane",
                "entities"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/identifier"
                },
                "plane": {
                  "const": "XY"
                },
                "expected_closed_contours": {
                  "const": 1
                },
                "entities": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "type",
                      "center",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/identifier"
                      },
                      "type": {
                        "const": "center_rectangle"
                      },
                      "center": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "$ref": "#/$defs/scalar"
                        }
                      },
                      "width": {
                        "$ref": "#/$defs/scalar"
                      },
                      "height": {
                        "$ref": "#/$defs/scalar"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "circular_cut": {
      "type": "object",
      "required": [
        "id",
        "type",
        "enabled",
        "depends_on",
        "produces",
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "cut.extrude"
        },
        "enabled": {
          "const": true
        },
        "depends_on": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "produces": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "kind": {
                "const": "face"
              }
            }
          }
        },
        "inputs": {
          "type": "object",
          "required": [
            "sketch",
            "direction",
            "through_all",
            "source_body"
          ],
          "additionalProperties": false,
          "properties": {
            "direction": {
              "const": "+Z"
            },
            "through_all": {
              "const": true
            },
            "source_body": {
              "type": "object",
              "required": [
                "result"
              ],
              "additionalProperties": false,
              "properties": {
                "result": {
                  "$ref": "#/$defs/identifier"
                }
              }
            },
            "sketch": {
              "type": "object",
              "required": [
                "id",
                "plane",
                "entities"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/identifier"
                },
                "plane": {
                  "const": "XY"
                },
                "expected_closed_contours": {
                  "const": 1
                },
                "entities": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "type",
                      "center",
                      "radius"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/identifier"
                      },
                      "type": {
                        "const": "circle"
                      },
                      "center": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "$ref": "#/$defs/scalar"
                        }
                      },
                      "radius": {
                        "$ref": "#/$defs/scalar"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
