        "end",
        "start",
        "sweep",
        "type"
      ],
      "additionalProperties": false
    },
    "path_segment": {
      "anyOf": [
        {
          "$ref": "#/$defs/line_segment"
        },
        {
          "$ref": "#/$defs/arc_segment"
        }
      ]
