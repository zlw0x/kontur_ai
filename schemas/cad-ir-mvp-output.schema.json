{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad.example.com/schemas/cad-ir-mvp-output/1.6",
  "title": "CAD-IR 1.6, narrowed to the geometry this build can construct",
  "description": "A subset of the canonical CAD-IR schema, expressed in the dialect the Codex structured-output API accepts: anyOf rather than oneOf, every node typed, every array with items, and every object listing all of its properties as required. The canonical schema says what version 1.2 can express; this says what may be generated, so the model is constrained at generation time instead of being corrected by a repair loop. Auxiliary planes and face selectors are part of 1.2 but not offered here: a selector's predicates are individually optional, and a dialect without optional properties would force the model to emit predicates the trusted validator rejects. Semantics the dialect cannot state — that a contour closes, for instance — are enforced by the adapter before anything reaches KOMPAS.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "cad-ai/cad-ir"
    },
    "schema_version": {
      "type": "string",
      "const": "1.6"
    },
    "document": {
      "type": "object",
      "properties": {
        "units": {
          "type": "string",
          "const": "mm"
        },
        "part_type": {
          "type": "string",
          "const": "single_part"
        },
        "coordinate_system": {
          "type": "string",
          "const": "right_handed"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "coordinate_system",
        "name",
        "part_type",
        "units"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "type": {
            "type": "string",
            "const": "length"
          },
          "value": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "unit": {
            "type": "string",
            "const": "mm"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "user_confirmed",
              "inferred",
              "assumed"
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "provenance",
          "status",
          "type",
          "unit",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "features": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/base_extrusion"
          },
          {
            "$ref": "#/$defs/cut_extrusion"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "expectations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/bounding_box_expectation"
          },
          {
            "$ref": "#/$defs/count_expectation"
          }
        ]
      },
      "minItems": 2,
      "maxItems": 8
    },
    "reference_geometry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 0
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generator": {
          "type": "string",
          "maxLength": 100
        },
        "generator_version": {
          "type": "string",
          "maxLength": 50
        },
        "prompt_version": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "generator",
        "generator_version",
        "prompt_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "document",
    "expectations",
    "features",
    "metadata",
    "parameters",
    "reference_geometry",
    "schema",
    "schema_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
    },
    "scalar": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "object",
          "properties": {
            "parameter": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "parameter"
          ],
          "additionalProperties": false
        }
      ]
    },
    "point": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scalar"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "line_segment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "line"
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        }
      },
      "required": [
        "end",
        "start",
        "type"
      ],
      "additionalProperties": false
    },
    "arc_segment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "arc"
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "sweep": {
          "type": "string",
          "enum": [
            "ccw",
            "cw"
          ]
        }
      },
      "required": [
        "center",
        "end",
        "start",
        "sweep",
        "type"
      ],
      "additionalProperties": false
    },
    "path_segment": {
      "anyOf": [
        {
          "$ref": "#/$defs/line_segment"
        },
        {
          "$ref": "#/$defs/arc_segment"
        }
      ]
    },
    "path_contour": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "path"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path_segment"
          },
          "minItems": 2,
          "maxItems": 200
        }
      },
      "required": [
        "segments",
        "type"
      ],
      "additionalProperties": false
    },
    "circle_contour": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "circle"
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "radius": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "center",
        "radius",
        "type"
      ],
      "additionalProperties": false
    },
    "rectangle_contour": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "rectangle"
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "width": {
          "$ref": "#/$defs/scalar"
        },
        "height": {
          "$ref": "#/$defs/scalar"
        },
        "rotation_deg": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "center",
        "height",
        "rotation_deg",
        "type",
        "width"
      ],
      "additionalProperties": false
    },
    "slot_contour": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "slot"
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        },
        "radius": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "end",
        "radius",
        "start",
        "type"
      ],
      "additionalProperties": false
    },
    "regular_polygon_contour": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "regular_polygon"
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "sides": {
          "type": "integer",
          "minimum": 3,
          "maximum": 64
        },
        "circumradius": {
          "$ref": "#/$defs/scalar"
        },
        "rotation_deg": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "center",
        "circumradius",
        "rotation_deg",
        "sides",
        "type"
      ],
      "additionalProperties": false
    },
    "contour": {
      "anyOf": [
        {
          "$ref": "#/$defs/path_contour"
        },
        {
          "$ref": "#/$defs/circle_contour"
        },
        {
          "$ref": "#/$defs/rectangle_contour"
        },
        {
          "$ref": "#/$defs/slot_contour"
        },
        {
          "$ref": "#/$defs/regular_polygon_contour"
        }
      ]
    },
    "construction_point": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "point"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "at": {
          "$ref": "#/$defs/point"
        }
      },
      "required": [
        "at",
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "construction_line": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "line"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        }
      },
      "required": [
        "end",
        "id",
        "start",
        "type"
      ],
      "additionalProperties": false
    },
    "construction_circle": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "circle"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "radius": {
          "$ref": "#/$defs/scalar"
        }
      },
      "required": [
        "center",
        "id",
        "radius",
        "type"
      ],
      "additionalProperties": false
    },
    "construction_entity": {
      "anyOf": [
        {
          "$ref": "#/$defs/construction_point"
        },
        {
          "$ref": "#/$defs/construction_line"
        },
        {
          "$ref": "#/$defs/construction_circle"
        }
      ]
    },
    "sketch": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "plane": {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "base"
            },
            "plane": {
              "type": "string",
              "const": "XY"
            }
          },
          "required": [
            "on",
            "plane"
          ],
          "additionalProperties": false
        },
        "outer": {
          "$ref": "#/$defs/contour"
        },
        "inner": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contour"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "construction": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/construction_entity"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 0
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 0
        }
      },
      "required": [
        "constraints",
        "construction",
        "dimensions",
        "id",
        "inner",
        "outer",
        "plane"
      ],
      "additionalProperties": false
    },
    "base_extrusion": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "const": "solid.extrude"
        },
        "enabled": {
          "type": "boolean"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 0,
          "maxItems": 0
        },
        "produces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "kind": {
                "type": "string",
                "const": "solid_body"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1
        },
        "inputs": {
          "type": "object",
          "properties": {
            "sketch": {
              "$ref": "#/$defs/sketch"
            },
            "direction": {
              "type": "string",
              "const": "+Z"
            },
            "distance": {
              "$ref": "#/$defs/scalar"
            }
          },
          "required": [
            "direction",
            "distance",
            "sketch"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "depends_on",
        "enabled",
        "id",
        "inputs",
        "produces",
        "type"
      ],
      "additionalProperties": false
    },
    "cut_extrusion": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "const": "cut.extrude"
        },
        "enabled": {
          "type": "boolean"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "produces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "kind": {
                "type": "string",
                "const": "face"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 0
        },
        "inputs": {
          "type": "object",
          "properties": {
            "sketch": {
              "$ref": "#/$defs/sketch"
            },
            "direction": {
              "type": "string",
              "const": "+Z"
            },
            "through_all": {
              "type": "boolean",
              "const": true
            },
            "source_body": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/$defs/identifier"
                }
              },
              "required": [
                "result"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "direction",
            "sketch",
            "source_body",
            "through_all"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "depends_on",
        "enabled",
        "id",
        "inputs",
        "produces",
        "type"
      ],
      "additionalProperties": false
    },
    "bounding_box_expectation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "const": "bounding_box"
        },
        "size_mm": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "y": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "z": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false
        },
        "tolerance_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "id",
        "size_mm",
        "tolerance_mm",
        "type"
      ],
      "additionalProperties": false
    },
    "count_expectation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "enum": [
            "body_count",
            "through_hole_count"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "id",
        "type",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
