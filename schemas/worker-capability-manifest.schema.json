{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad.example.com/schemas/worker-capability-manifest/1.0",
  "title": "WorkerCapabilityManifest",
  "$defs": {
    "CapabilityDeclaration": {
      "additionalProperties": false,
      "description": "What a worker says about one capability.",
      "properties": {
        "status": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "version": {
          "default": "1.0",
          "pattern": "^\\d+(\\.\\d+){0,2}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "CapabilityDeclaration",
      "type": "object"
    },
    "CapabilityStatus": {
      "enum": [
        "unsupported",
        "experimental",
        "beta",
        "stable",
        "disabled"
      ],
      "title": "CapabilityStatus",
      "type": "string"
    },
    "WorkerEngineDeclaration": {
      "additionalProperties": false,
      "description": "Which CAD engine a worker builds with, and on what kernel.\n\nAdded by ENGINE-MIG-007 rather than reusing `kompas_version`, which names one\nengine and reports a version that only that engine has. Putting an\nOpenCascade version in a field called `kompas_version` would make every\nreader of a manifest wrong about what produced the model, and the field is\nstill the right one for the worker that does drive KOMPAS — until\nENGINE-MIG-008 removes both it and the engine.\n\nOptional, because a worker older than this build does not send it and being\nunable to say which engine it uses is not a reason to refuse its work.",
      "properties": {
        "engine_id": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Engine Id",
          "type": "string"
        },
        "engine_version": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "kernel_id": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Kernel Id",
          "type": "string"
        },
        "kernel_version": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kernel Version"
        }
      },
      "required": [
        "engine_id",
        "engine_version",
        "kernel_id"
      ],
      "title": "WorkerEngineDeclaration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "worker_version": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Worker Version",
      "type": "string"
    },
    "engine": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkerEngineDeclaration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kompas_version": {
      "anyOf": [
        {
          "maxLength": 50,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kompas Version"
    },
    "codex_cli_version": {
      "anyOf": [
        {
          "maxLength": 50,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Codex Cli Version"
    },
    "cad_ir_versions": {
      "items": {
        "maxLength": 20,
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Cad Ir Versions",
      "type": "array"
    },
    "capabilities": {
      "maxProperties": 500,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/CapabilityDeclaration"
        }
      },
      "title": "Capabilities",
      "type": "object"
    }
  },
  "required": [
    "worker_version",
    "cad_ir_versions",
    "capabilities"
  ],
  "type": "object"
}
