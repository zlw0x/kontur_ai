{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad.example.com/schemas/agent-result/0.1.0",
  "type": "object",
  "required": ["schema_version", "stage", "status", "confidence", "warnings", "result"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "stage": {"type": "string"},
    "status": {"type": "string", "enum": ["success", "need_user_input", "manual_review", "failed"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "result": {"type": "object"}
  },
  "additionalProperties": false
}
