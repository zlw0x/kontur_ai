{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad.example.com/schemas/drawing-analysis/0.1.0",
  "type": "object",
  "required": ["schema_version", "stage", "status", "confidence", "warnings", "result"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "stage": {"type": "string", "const": "drawing_analysis"},
    "status": {"type": "string", "enum": ["success", "need_user_input", "manual_review", "failed"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "result": {
      "type": "object",
      "required": ["ready_for_cad", "summary", "parameters", "shape", "questions"],
      "properties": {
        "ready_for_cad": {"type": "boolean"},
        "summary": {"type": "string", "maxLength": 2000},
        "parameters": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["id", "name", "value", "unit", "status", "confidence", "source"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
              "name": {"type": "string", "maxLength": 200},
              "value": {"type": ["number", "null"]},
              "unit": {"type": "string", "enum": ["mm", "deg", "count"]},
              "status": {"type": "string", "enum": ["confirmed", "inferred", "unresolved"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "source": {"type": "string", "maxLength": 500}
            },
            "additionalProperties": false
          }
        },
        "shape": {
          "type": "object",
          "description": "What the part is, structurally: the outline, the openings, how many solids and which parameter is the thickness. Never where anything is - coordinates are the compilation stage's job. This is checked against the compiled CAD-IR by trusted code, so a misread outline is caught before a valid document that builds the wrong part reaches anyone.",
          "required": ["profile", "openings", "solids", "thickness_parameter", "note"],
          "properties": {
            "profile": {
              "type": "string",
              "description": "The outline of the part. Use closed_profile when the outline is not one of the named shapes; never pick the nearest named one.",
              "enum": ["rectangle", "circle", "slot", "regular_polygon", "closed_profile"]
            },
            "openings": {
              "type": "array",
              "maxItems": 32,
              "description": "Holes and cut-outs, grouped by the shape of the opening and by whether they go through. Count every one the drawing shows. Empty when the part has none.",
              "items": {
                "type": "object",
                "required": ["kind", "count", "through"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["round", "slot", "rectangular", "polygonal", "profiled"]
                  },
                  "count": {"type": "integer", "minimum": 1, "maximum": 1000},
                  "through": {
                    "type": ["boolean", "null"],
                    "description": "true when the drawing shows these going all the way through, false when they stop inside the material, null when it does not say. Guessing is worse than null: a depth nobody stated is the one thing no later check can recover."
                  }
                },
                "additionalProperties": false
              }
            },
            "solids": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "description": "How many separate solid bodies of material the part is made of: one for a plain plate, two for a plate with a boss standing on it."
            },
            "thickness_parameter": {
              "type": ["string", "null"],
              "maxLength": 64,
              "description": "The id of the parameter above that holds the part's depth, or null when the drawing does not give one. Naming it is what keeps the dimension a name rather than a number."
            },
            "note": {
              "type": ["string", "null"],
              "maxLength": 500,
              "description": "What the outline is, in words, when profile is closed_profile. Read by a person, never by a check."
            }
          },
          "additionalProperties": false
        },
        "questions": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["id", "parameter_id", "text"],
            "properties": {
              "id": {"type": "string", "pattern": "^q_[A-Za-z0-9_.-]{1,61}$"},
              "parameter_id": {
                "type": "string",
                "description": "The parameter this question is about, or the literal \"shape\" when the question is about the outline or the openings rather than a number."
              },
              "text": {"type": "string", "maxLength": 500}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
