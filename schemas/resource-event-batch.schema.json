{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad.example.com/schemas/resource-event-batch/1.0",
  "title": "ResourceEventBatch",
  "$defs": {
    "AgentRole": {
      "enum": [
        "DRAWING_EXTRACTION",
        "GEOMETRY_REASONING",
        "CLARIFICATION",
        "CAD_PLANNING",
        "CAD_IR_COMPILATION",
        "REPAIR",
        "FINAL_AUDIT"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "AiUsage": {
      "additionalProperties": false,
      "description": "What was asked of Codex, what came back, and how much is confirmed.\n\n`requested_model` and `observed_model` are deliberately separate. Collapsed\ninto one field, \"we asked for Terra\" becomes indistinguishable from \"Terra\nis what ran\", and only the second justifies charging Terra's weight.",
      "properties": {
        "requested_model": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Model"
        },
        "observed_model": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Model"
        },
        "requested_reasoning_effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_reasoning_effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_observation_status": {
          "$ref": "#/$defs/ModelObservationStatus",
          "default": "UNKNOWN"
        },
        "routing_profile_version": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Routing Profile Version"
        },
        "routing_rule_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Routing Rule Id"
        },
        "service_tier": {
          "$ref": "#/$defs/ServiceTier",
          "default": "standard"
        },
        "cli_version": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cli Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "prompt_bundle_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Bundle Sha256"
        },
        "provenance_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Sha256"
        },
        "thread_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "token_source": {
          "$ref": "#/$defs/TokenSource",
          "default": "UNKNOWN"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "AiUsage",
      "type": "object"
    },
    "CadUsage": {
      "additionalProperties": false,
      "properties": {
        "operation_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Code"
        },
        "operation_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Count"
        },
        "failed_feature_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed Feature Count"
        },
        "session_reuse_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Reuse Count"
        },
        "forced_termination": {
          "default": false,
          "title": "Forced Termination",
          "type": "boolean"
        },
        "result_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Bytes"
        }
      },
      "title": "CadUsage",
      "type": "object"
    },
    "ModelObservationStatus": {
      "description": "How much is actually known about which model served a run.",
      "enum": [
        "UNKNOWN",
        "EXPLICIT_NOT_REPORTED",
        "VERIFIED",
        "MISMATCH"
      ],
      "title": "ModelObservationStatus",
      "type": "string"
    },
    "ProcessUsage": {
      "additionalProperties": false,
      "properties": {
        "cpu_user_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu User Ms"
        },
        "cpu_system_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu System Ms"
        },
        "peak_memory_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Memory Bytes"
        },
        "bytes_read": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Read"
        },
        "bytes_written": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Written"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "termination_reason": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Termination Reason"
        },
        "retry_number": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Number",
          "type": "integer"
        }
      },
      "title": "ProcessUsage",
      "type": "object"
    },
    "ReasoningEffort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "ReasoningEffort",
      "type": "string"
    },
    "ResourceEvent": {
      "additionalProperties": false,
      "description": "One immutable measurement. `event_key` is the idempotency identity.",
      "properties": {
        "event_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._\\-]{0,199}$",
          "title": "Event Key",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/ResourceEventType"
        },
        "stage": {
          "$ref": "#/$defs/ResourceStage"
        },
        "attempt_no": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt No",
          "type": "integer"
        },
        "agent_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "wall_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Ms"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "failure_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "ai": {
          "anyOf": [
            {
              "$ref": "#/$defs/AiUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "process": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cad": {
          "anyOf": [
            {
              "$ref": "#/$defs/CadUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "storage_byte_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Byte Seconds"
        },
        "human_minutes": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Minutes"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "event_key",
        "event_type",
        "stage",
        "started_at",
        "success"
      ],
      "title": "ResourceEvent",
      "type": "object"
    },
    "ResourceEventType": {
      "enum": [
        "AI_RUN",
        "PROCESS_RUN",
        "CAD_SESSION",
        "CAD_OPERATION",
        "CAD_REBUILD",
        "REPAIR_ITERATION",
        "EXPORT",
        "VALIDATION",
        "PREVIEW_RENDER",
        "TRANSFER",
        "HUMAN_REVIEW",
        "WARNING"
      ],
      "title": "ResourceEventType",
      "type": "string"
    },
    "ResourceStage": {
      "enum": [
        "IMAGE_PREPROCESSING",
        "DRAWING_ANALYSIS",
        "CLARIFICATION",
        "CAD_PLANNING",
        "CAD_IR_COMPILATION",
        "SCHEMA_VALIDATION",
        "SEMANTIC_VALIDATION",
        "CAD_STARTUP",
        "KOMPAS_STARTUP",
        "DOCUMENT_BUILD",
        "FEATURE_BUILD",
        "SELECTOR_RESOLUTION",
        "REBUILD",
        "EXPORT",
        "GEOMETRY_VALIDATION",
        "PREVIEW",
        "ARTIFACT_UPLOAD",
        "CLEANUP",
        "HUMAN_REVIEW"
      ],
      "title": "ResourceStage",
      "type": "string"
    },
    "ServiceTier": {
      "enum": [
        "standard",
        "fast"
      ],
      "title": "ServiceTier",
      "type": "string"
    },
    "TokenSource": {
      "description": "How token counts were obtained; never guess, mark what was measured.",
      "enum": [
        "STRUCTURED",
        "SUMMARY",
        "ESTIMATED",
        "UNKNOWN"
      ],
      "title": "TokenSource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ResourceEvent"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "events"
  ],
  "type": "object"
}
