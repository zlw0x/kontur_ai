<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cad-worker</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The prompt version is worth asserting against its own declaration rather
         than a literal in a test, so editing a prompt cannot fail a ledger test. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>CadAi.LocalWorker.Tests</_Parameter1>
    </AssemblyAttribute>
    <Compile Remove="tests\**\*.cs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="..\..\packages\build123d-launcher\CadAi.Build123dLauncher.csproj" />
    <ProjectReference Include="..\..\packages\codex-runner\CadAi.CodexRunner.csproj" />
    <ProjectReference Include="..\..\packages\geometry-validation\CadAi.GeometryValidation.csproj" />
    <ProjectReference Include="..\..\packages\kompas-adapter\CadAi.KompasAdapter.csproj" />
    <None Include="..\..\schemas\drawing-analysis.schema.json" Link="schemas\drawing-analysis.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schemas\cad-ir.schema.json" Link="schemas/cad-ir.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schemas\cad-ir-mvp-output.schema.json" Link="schemas/cad-ir-mvp-output.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
